---
import Base from '../layouts/Base.astro';
import SectionHead from './SectionHead.astro';
import ServiceCard from './ServiceCard.astro';
import Kicker from './Kicker.astro';
import {
  contact,
  featuredServiceIndex,
  getCases,
  getExtras,
  getPains,
  getPrincipios,
  getServices,
  getSteps,
} from '../i18n/content';
import * as m from '../paraglide/messages';

const services = getServices();
const cases = getCases();
const steps = getSteps();
const principios = getPrincipios();
const extras = getExtras();
const pains = getPains();
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow"><span class="chev">&gt;</span> {m.hero_eyebrow()}</p>
      <h1>{m.hero_h1()}</h1>
      <p class="lead">{m.hero_lead()}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contacto"><span class="chev">&gt;</span> {m.hero_cta_primary()}</a>
        <a class="btn btn-ghost" href="#servicios">{m.hero_cta_ghost()}</a>
      </div>
    </div>
  </section>

  <!-- PROBLEMA -->
  <section class="problema">
    <div class="container">
      <SectionHead title={m.problem_title()} intro={m.problem_intro()} />
      <ul class="pain">
        {pains.map((p) => <li><span class="chev">&gt;</span> {p}</li>)}
      </ul>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section id="servicios">
    <div class="container">
      <SectionHead kicker={m.services_kicker()} title={m.services_title()} intro={m.services_intro()} />
      {services.filter((_, i) => i === featuredServiceIndex).map((s) => <ServiceCard {...s} featured />)}
      <div class="cards">
        {services.filter((_, i) => i !== featuredServiceIndex).map((s) => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <!-- LO QUE HE CONSTRUIDO -->
  <section id="casos" class="alt">
    <div class="container">
      <SectionHead kicker={m.cases_kicker()} title={m.cases_title()} intro={m.cases_intro()} />
      <div class="case-cards">
        {
          cases.map((c) => (
            <article class="mini-card">
              <div class="mini-head">
                <h3>{c.nombre}</h3>
                <span class="tag">{c.tag}</span>
              </div>
              <p>{c.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA -->
  <section id="como-trabajo">
    <div class="container">
      <SectionHead kicker={m.how_kicker()} title={m.how_title()} intro={m.how_intro()} />
      <ol class="pasos">
        {
          steps.map((s, i) => (
            <li class="paso">
              <span class="paso-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.titulo}</h3>
              <p>{s.desc}</p>
            </li>
          ))
        }
      </ol>
      <div class="principios">
        {
          principios.map((p) => (
            <div class="principio">
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SOBRE MÍ + EL RESTO -->
  <section class="sobre alt">
    <div class="container split">
      <div>
        <SectionHead kicker={m.about_kicker()} title={m.about_title()} />
        <p class="section-intro" set:html={m.about_body_html()} />
      </div>
      <div>
        <Kicker text={m.about_extra_kicker()} />
        <p class="extras-intro">{m.about_extra_intro()}</p>
        <div class="mini-cards">
          {
            extras.map((e) => (
              <article class="mini-card">
                <h3>{e.titulo}</h3>
                <p>{e.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="contacto">
    <div class="container">
      <SectionHead kicker={m.contact_kicker()} title={m.contact_title()} intro={m.contact_intro()} />
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${contact.email}`}
          ><span class="chev">&gt;</span> {contact.email}</a
        >
        <a class="btn btn-ghost" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
      </div>
    </div>
  </section>
</Base>
