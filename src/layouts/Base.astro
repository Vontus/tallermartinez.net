---
import '../styles/global.css';
import { contact, localeMeta } from '../i18n/content';
import { getLocale, localizeHref, locales } from '../paraglide/runtime';
import * as m from '../paraglide/messages';

const locale = getLocale();
const meta = localeMeta[locale];

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(meta.ogImage, Astro.site).href;

// URLs por idioma vía el routing de Paraglide + x-default al selector de la raíz.
const localeUrl = (l: typeof locale) => new URL(localizeHref('/', { locale: l }), Astro.site).href;
const xDefault = new URL('/', Astro.site).href;

const knowsAbout = [
  m.meta_knows_about_0(),
  m.meta_knows_about_1(),
  m.meta_knows_about_2(),
  m.meta_knows_about_3(),
  m.meta_knows_about_4(),
  m.meta_knows_about_5(),
  m.meta_knows_about_6(),
  m.meta_knows_about_7(),
];
const areaServed = [m.meta_area_served_0(), m.meta_area_served_1(), m.meta_area_served_2()];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Taller Martínez',
  description: m.meta_description(),
  url: canonical,
  image: ogImage,
  email: contact.email,
  telephone: contact.phone.replace(/\s/g, ''),
  priceRange: '€€',
  founder: { '@type': 'Person', name: 'Alberto Martínez' },
  sameAs: ['https://vontus.dev'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Torrevieja',
    addressRegion: 'Alicante',
    addressCountry: 'ES',
  },
  areaServed: areaServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  knowsAbout,
};
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{m.meta_title()}</title>
    <meta name="description" content={m.meta_description()} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={localeUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#16181b" />

    <!-- Geo / local -->
    <meta name="geo.region" content="ES-A" />
    <meta name="geo.placename" content="Torrevieja" />
    <meta name="geo.position" content="37.978;-0.682" />
    <meta name="ICBM" content="37.978, -0.682" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taller Martínez" />
    <meta property="og:title" content={m.meta_title()} />
    <meta property="og:description" content={m.meta_description()} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={m.meta_title()} />
    <meta name="twitter:description" content={m.meta_description()} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={localizeHref('/')} aria-label="Taller Martínez">
          <img class="logo-mark" src={`${base}logo.svg`} width="32" height="32" alt="" />
          <img class="wordmark" src={`${base}wordmark.svg`} alt="Taller Martínez" />
        </a>
        <nav class="nav">
          <a href="#servicios">{m.nav_services()}</a>
          <a href="#como-trabajo">{m.nav_how()}</a>
          <span class="lang" aria-label={m.nav_lang_label()}>
            {
              locales.map((l) => (
                <a href={localizeHref('/', { locale: l })} class={l === locale ? 'active' : ''} hreflang={l}>
                  {l.toUpperCase()}
                </a>
              ))
            }
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {year} Taller Martínez · {m.footer_location()}</span>
        <span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a> ·
          <a href="https://vontus.dev" rel="noopener" target="_blank">vontus.dev</a>
        </span>
      </div>
    </footer>
  </body>
</html>
